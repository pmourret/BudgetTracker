# ============================================================
# Exemple de configuration de PROD (LAN strict, HTTPS via Traefik).
# Copier en .env.prod et remplacer les "changeme" par des secrets réels.
# Le vrai .env.prod n'est JAMAIS committé (voir .gitignore).
# ============================================================

# Module de settings (manage.py / wsgi font setdefault sur dev → forcer ici)
DJANGO_SETTINGS_MODULE=config.settings.prod

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=changeme
# `backend` : nom de service interne, requis pour les appels nginx → gunicorn.
DJANGO_ALLOWED_HOSTS=budgets.sternum-lab.duckdns.org,backend
# Schéma `https://` obligatoire : c'est l'Origin réel du navigateur.
CSRF_TRUSTED_ORIGINS=https://budgets.sternum-lab.duckdns.org

# Ces trois-là alimentent À LA FOIS l'image postgres et Django (settings/base.py
# les lit en priorité, avec les DB_* en repli).
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=changeme
# Hôte et port : `db` est le nom du service dans docker-compose.prod.yml.
# Explicites plutôt qu'implicites — ils reposaient sur les valeurs par défaut du
# code, ce qui marche mais ne se lit nulle part.
DB_HOST=db
DB_PORT=5432
# ⚠️ `DATABASE_URL` a été retiré : **il n'était lu par aucun code**. Une variable
# d'exemple que rien ne consomme finit par être crue, puis modifiée en vain.

# ============================================================
# Service d'identité partagé (annuaire)
# Cadrage : FamilyToolSuite/FoyerOS/docs/cadrage-identite-partagee.md
# ============================================================

# Interrupteur de bascule. `False` : BudgetTracker émet ses propres jetons.
# `True` : il relaie la connexion vers l'annuaire et ne signe plus rien.
# Revenir à `False` restaure le comportement d'avant, sans déploiement de code.
IDENTITE_AUTORITE=True

IDENTITE_URL=https://identite.sternum-lab.duckdns.org
IDENTITE_TIMEOUT=5

# Clé PUBLIQUE de l'annuaire — fournie par FICHIER (voir la mise en garde dans
# le .env.prod.example de FoyerOS : un PEM ne rentre pas dans une variable).
# Le compose doit monter ce chemin.
IDENTITE_CLE_PUBLIQUE_FICHIER=/run/cles/annuaire_public.pem

# ⚠️ DE QUEL FOYER CETTE INSTANCE EST-ELLE CELLE ?
# Une instance BudgetTracker par foyer (décision de suite du 2026-08-01) : le
# claim `foyers` du jeton est la SEULE chose qui permette de refuser un membre
# du foyer voisin.
#  - vide  → aucun jeton de l'annuaire n'est accepté (fermé par défaut) ;
#  - faux  → la connexion réussit, puis TOUT retombe en 401. Piège vécu.
# L'UUID se lit dans FoyerOS, ou via `GET /api/v1/auth/me/` sur l'annuaire.
IDENTITE_FOYER=
