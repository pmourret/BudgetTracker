# Le client HTTP utilise une baseURL relative ('/api/v1', voir src/api/client.js) :
# front et API sont servis par le même hôte via nginx → aucune URL d'API à
# injecter au build. Ne pas réintroduire de VITE_API_URL : elle figerait le
# domaine dans le bundle, et un changement de domaine imposerait un rebuild.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
